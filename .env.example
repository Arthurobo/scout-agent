# Names only. Real values live in ~/.config/scout/secrets.env and the Trigger.dev dashboard.

# Slack bot token (xoxb-...) for the Scout app
SLACK_BOT_TOKEN=
# Required in every environment: GitHub returns a profile public email only to authenticated requests, so without it Scout finds no email routes.
# Use a fine-grained token with "Public repositories (read-only)" access only. Never a token that can read private repos.
GITHUB_TOKEN=
# OpenRouter key used by the agent model
OPENROUTER_API_KEY=
# OpenRouter model id, e.g. deepseek/deepseek-v4.1-flash
MODEL_ID=
# Scaleway Transactional Email secret key and project
SCW_SECRET_KEY=
SCW_PROJECT_ID=
# Sender on the verified Scaleway domain. Use a real person's display name, not "Scout". Quote values with spaces or angle brackets if a shell sources this file.
EMAIL_FROM="Your Name <scout@example.com>"
# One-line signature appended to every draft before the opt-out line, e.g. Your Name, founder, Your Company
OUTREACH_SIGNATURE=
# Reply-To address for outreach (the owner's mailbox)
REPLY_TO=
# true adds the X-Scout-Outreach audit header; set false if Scaleway rejects it
SCOUT_AUDIT_HEADER=
# Postgres connection string (local Docker or Neon with sslmode=require)
DATABASE_URL=
# Comma-separated Slack user ids allowed to approve outreach
APPROVER_SLACK_IDS=
# true limits candidates to the logins below (recordings show only consenting people)
DEMO_MODE=
# Comma-separated GitHub logins allowed in demo mode
DEMO_ALLOWED_LOGINS=
# Comma-separated email addresses Scout may send to when SEND_MODE is allowlist
SEND_ALLOWED_RECIPIENTS=
# allowlist (default when empty): only the addresses above can be drafted or sent to. open: any address.
SEND_MODE=
# Local CLI only: Trigger.dev secret key for dev/deploy
TRIGGER_SECRET_KEY=
